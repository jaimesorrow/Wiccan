# Copy to app/keystore.properties (gitignored) and fill in real values.
# Keep the keystore and credentials secure and out of Git.
# With Play App Signing, request an upload-key reset in Play Console if
# the upload key is lost. Keep a secure backup of any self-managed app
# signing key, since Google cannot recover it.
#
# storeFile is resolved relative to the app/ module directory.
storeFile=../release.keystore.jks
storePassword=REPLACE_ME
keyAlias=REPLACE_ME
keyPassword=REPLACE_ME
