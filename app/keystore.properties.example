# Copy to app/keystore.properties (gitignored) and fill in real values -
# never commit this file with real credentials, and never lose the keystore
# itself: a lost signing key means you can never publish an update to an
# app that's already live under it, with no recovery path from Google.
#
# storeFile is resolved relative to the app/ module directory.
storeFile=../release.keystore.jks
storePassword=REPLACE_ME
keyAlias=REPLACE_ME
keyPassword=REPLACE_ME
