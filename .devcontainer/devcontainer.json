{
  "name": "Wiccan Android",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "ANDROID_SDK_ROOT": "/opt/android-sdk"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk",
    "GRADLE_USER_HOME": "/home/vscode/.gradle"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [
    4000,
    5001,
    8080,
    8085,
    9099
  ],
  "portsAttributes": {
    "4000": {
      "label": "Firebase Emulator UI"
    },
    "5001": {
      "label": "Cloud Functions emulator"
    },
    "8080": {
      "label": "Cloud Firestore emulator"
    },
    "8085": {
      "label": "Pub/Sub emulator"
    },
    "9099": {
      "label": "Firebase Auth emulator"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-gradle",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
