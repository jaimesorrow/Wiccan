{
  "name": "wiccan-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Wiccan Cloud Functions: server-side daily content selection.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "lint": "eslint src",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "generate-draft": "npm run build && node lib/scripts/generateDraftCli.js",
    "approve-draft": "npm run build && node lib/scripts/approveDraftCli.js",
    "seed-content": "npm run build && node lib/scripts/seedContentCli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@googleapis/androidpublisher": "^42.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
