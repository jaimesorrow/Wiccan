{
  "name": "wiccan-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Wiccan Cloud Functions: server-side daily content selection.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:firebase": "npm run build && npx --yes firebase-tools@15.33.0 emulators:exec --config ../firebase.json --only firestore --project demo-wiccan \"node --test tests/firebaseSecurity.test.mjs\"",
    "lint": "eslint src",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "content-agent": "npm run build && node lib/scripts/generateDraftCli.js",
    "generate-draft": "npm run build && node lib/scripts/generateDraftCli.js",
    "approve-draft": "npm run build && node lib/scripts/approveDraftCli.js",
    "seed-content": "npm run build && node lib/scripts/seedContentCli.js",
    "verify-lessons": "npm run build && node lib/scripts/verifyLessonsCli.js",
    "backfill-content-usage": "npm run build && node lib/scripts/backfillContentUsageCli.js",
    "audit-content": "npm run build && node lib/scripts/auditContentCli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@googleapis/androidpublisher": "^42.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "firebase": "^12.19.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "handlebars": "4.7.10",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
