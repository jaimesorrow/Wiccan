{
  "name": "wiccan-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Wiccan Cloud Functions: server-side daily content selection.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "generate-draft": "npm run build && node lib/scripts/generateDraftCli.js",
    "approve-draft": "npm run build && node lib/scripts/approveDraftCli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@googleapis/androidpublisher": "^38.0.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
