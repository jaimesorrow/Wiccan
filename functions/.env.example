# Copy to .env.<project-id> (Firebase Functions v2 loads that file
# automatically for the matching project - see `firebase functions:secrets`
# for anything more sensitive than these). Never commit a real .env file,
# and never reuse the same values across dev/staging/production - each
# environment should have its own Anthropic key and its own Play service
# account, so a leaked or misbehaving one can be revoked without taking
# every environment down with it.

# Required for generateDraft (npm run generate-draft): the Anthropic API
# key used by ClaudeDraftGenerator. Picked up automatically by
# `new Anthropic()` - the SDK reads this env var itself.
ANTHROPIC_API_KEY=

# Required for Play Billing: use THIS Firebase project's registered Android
# applicationId. All Android flavors use com.jaimesorrow.wiccan; each
# separate Firebase project must register that same package. Leaving this
# blank prevents accidental billing calls with an implicit package default.
ANDROID_PACKAGE_NAME=

# Optional; the default Play RTDN topic is play-rtdn.
# PLAY_RTDN_TOPIC=play-rtdn

# Local SDK/admin CLI credential selector, only when using a key file.
# Keep the file outside the repository. Firestore admin scripts need
# Firestore access; local Play Billing calls also need Play Console access.
# Deployed Functions use the runtime service account via ADC: authorize
# that account in Play Console instead of deploying a local key-file path.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
