rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasSubscription() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return user.data.tier == 'premium'
        && user.data.get('deletionInProgress', false) != true
        && user.data.get('subscriptionExpiresAtMillis', 0) is number
        && user.data.get('subscriptionExpiresAtMillis', 0) > request.time.toMillis();
    }
    // Daily selection must run server-side (Cloud Function) so users can't
    // reset or game their delivery history. Clients get read-only access
    // to published content already delivered to them and to their own history
    // rows; all writes go through the Admin SDK inside getTodayContent. A
    // delivery marker is required for Grimoire reads, so published content cannot be scraped
    // to bypass either subscription tiers or the one-entry-per-day selection.
    match /content/{contentId} {
      allow get: if request.auth != null && hasSubscription() && resource.data.status == 'published'
        && exists(/databases/$(database)/documents/userContentUsage/$(request.auth.uid)/content/$(contentId));
      allow list: if false;
      allow write: if false;
    }

    match /userContentHistory/{historyId} {
      allow read: if request.auth != null && hasSubscription() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // A per-user transaction revision serializes assignments on different
    // dates; clients cannot inspect or reset this server-owned reservation.
    match /userContentUsage/{uid} {
      allow read, write: if false;
    }

    // A per-user, per-content marker reserves each delivered ID across
    // different dates; only the server may inspect or write these markers.
    match /userContentUsage/{uid}/content/{contentId} {
      allow read, write: if false;
    }

    // Editorial similarity markers reserve related lessons together;
    // clients cannot inspect or reset them to obtain a repeated lesson.
    match /userContentUsage/{uid}/similarityGroups/{groupId} {
      allow read, write: if false;
    }

    // tier is set only by the verifyPurchase and daily lapse-recheck Cloud
    // Functions (Admin SDK) — the client's own billing state is never
    // trusted, so it only ever reads its own doc to sync the UI.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Device registrations (FCM token + time zone per device) are written
    // only by the registerDeviceToken/unregisterDeviceToken/updateTimeZone
    // callables via the Admin SDK. No client ever needs to read another
    // device's token, including its own on a different device.
    match /users/{uid}/devices/{deviceId} {
      allow read, write: if false;
    }

    // Server-only subscription audit and hashed-token ownership registry.
    match /subscriptions/{uid} {
      allow read, write: if false;
    }
    match /purchaseTokens/{tokenHash} {
      allow read, write: if false;
    }
    match /userPurchaseTokens/{uid}/tokens/{tokenHash} {
      allow read, write: if false;
    }

    // Ops-only runtime kill switches (dailyContentEnabled,
    // notificationsEnabled). Read only by the Admin SDK inside
    // getTodayContent/sendDailyNotificationsJob; edited only by an
    // operator directly in the Firebase Console or via the Admin SDK -
    // never by the app.
    match /systemConfig/{doc} {
      allow read, write: if false;
    }
  }
}
