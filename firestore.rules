rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Daily selection must run server-side (Cloud Function) so users can't
    // reset or game their delivery history. Clients get read-only access
    // to published content and to their own history rows; all writes go
    // through the Admin SDK inside getTodayContent. Rules do not tier-gate
    // published content reads — that's enforced by the getTodayContent
    // selection itself, a known limitation of this pass.
    match /content/{contentId} {
      allow read: if request.auth != null && resource.data.status == 'published';
      allow write: if false;
    }

    match /userContentHistory/{historyId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // tier is set only by the verifyPurchase and daily lapse-recheck Cloud
    // Functions (Admin SDK) — the client's own billing state is never
    // trusted, so it only ever reads its own doc to sync the UI.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
